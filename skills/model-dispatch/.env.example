# Model Dispatch 配置模板
# 复制为 .env 并填入真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不会被提交

# ─── 千问 / 阿里云 DashScope ───
# 获取: https://platform.qianwenai.com/home/api-keys
# 支持 sk-（旧版）/ sk-ws-（按量付费）/ sk-sp-（Token Plan，自动识别）
DASHSCOPE_API_KEY=

# ─── DeepSeek 官方 ───
# 获取: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ─── OpenRouter（可选，聚合多家模型）───
# 获取: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── 可选：汇率（OpenRouter 价格换算用）───
# USD_CNY=7.1

# ─── 可选：其他 OpenAI 兼容平台 ───
# 配置方式见 config/providers.json，已预置以下平台的 baseURL：
# MOONSHOT_API_KEY=       # Kimi
# ZHIPU_API_KEY=          # 智谱 GLM
# SILICONFLOW_API_KEY=    # 硅基流动
# MINIMAX_API_KEY=        # MiniMax
